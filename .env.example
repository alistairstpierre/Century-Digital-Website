# Copy this file to .env and fill in your values

# Facebook Pixel ID (for page view + Book a Call click tracking)
# Get it from Meta Events Manager: https://business.facebook.com/events_manager
# Must be prefixed with PUBLIC_ so it's available in the browser
PUBLIC_FB_PIXEL_ID=

# Meta Conversions API (CAPI) access token – server-side Lead when users land on thank-you page
# Generate in Events Manager → your Pixel → Settings → Conversions API → Generate access token
# Keep this secret (do NOT use PUBLIC_ prefix). Required for /api/track-lead.
META_CAPI_ACCESS_TOKEN=

# Resend API Key (get one at https://resend.com/api-keys)
# Free tier: 3,000 emails/month
RESEND_API_KEY=re_your_api_key_here

# Email recipient (where form submissions will be sent)
EMAIL_RECIPIENT=support@centurydigital.net

# Email sender (must be a verified domain in Resend)
# Format: "Display Name <email@domain.com>"
EMAIL_FROM=Century Digital <noreply@centurydigital.net>
