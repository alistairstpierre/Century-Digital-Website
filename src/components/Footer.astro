---
// Footer component for Century Digital
// Contains links, contact info, and copyright
---

<footer id="contact" class="w-full bg-gray-100 border-t border-[#93c5fd] scroll-mt-24 px-4 sm:px-6">
	<div class="section-inner flex flex-col gap-4">
		<div class="w-full grid grid-cols-1 md:grid-cols-3 gap-16">
			<!-- Brand -->
			<div>
				<div class="flex items-center gap-3 mb-8">
					<img 
						src="/century-logo2.png" 
						alt="Century Digital" 
						class="h-10 w-auto" 
						loading="lazy"
						decoding="async"
						width="120"
						height="40"
					/>
					<span class="text-2xl font-bold gradient-text">Century Digital</span>
				</div>
				<p class="text-gray-600 mb-8 leading-relaxed">
					Premium annuity lead generation for Independent Producers and Financial Advisors.
				</p>
				<p class="text-gray-500 text-sm">
					Stop chasing disconnected numbers. Start writing paper.
				</p>
			</div>

			<!-- Services -->
			<div>
				<h4 class="text-lg font-semibold mb-8 text-gray-900">Services</h4>
				<ul class="space-y-4 text-gray-600">
					<li><a href="#services" class="hover:text-[#1e40af] transition-colors">Social Media Advertising</a></li>
					<li><a href="#services" class="hover:text-[#1e40af] transition-colors">Internal Sales Team (ISA)</a></li>
					<li><a href="#services" class="hover:text-[#1e40af] transition-colors">Annuity Leads</a></li>
					<li><a href="#services" class="hover:text-[#1e40af] transition-colors">Sales Coaching</a></li>
				</ul>
			</div>

			<!-- Contact -->
			<div>
				<h4 class="text-lg font-semibold mb-8 text-gray-900">Contact Us</h4>
				<ul class="space-y-4 text-gray-600">
					<li>
						<a href="mailto:support@centurydigital.net" class="hover:text-[#1e40af] transition-colors">
							support@centurydigital.net
						</a>
					</li>
					<li>
						<a href="#contact" class="btn-cta inline-flex items-center justify-center min-w-[180px] bg-gradient-to-r from-[#1e40af] to-[#1e293b] rounded-2xl text-lg font-semibold hover:from-[#1e3a8a] hover:to-[#0f172a] transition-all mt-2 text-white">
							Book a Call
						</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="border-t border-[#93c5fd] pt-4 flex flex-col md:flex-row justify-between items-center gap-4">
			<p class="text-gray-500 text-sm">
				© 2026 Century Digital. All Rights Reserved.
			</p>
			<div class="flex space-x-8">
				<a href="#" class="text-gray-500 hover:text-[#1e40af] transition-colors text-sm">Privacy Policy</a>
				<a href="#" class="text-gray-500 hover:text-[#1e40af] transition-colors text-sm">Terms of Use</a>
			</div>
		</div>
	</div>
</footer>
