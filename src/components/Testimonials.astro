---
// Testimonials section component
// Displays social proof from successful producers
---

<section id="testimonials" class="w-full bg-white scroll-mt-24 px-4 sm:px-6">
	<div class="section-inner flex flex-col gap-4">
		<div class="text-center flex flex-col items-center gap-4">
			<h2 class="text-4xl md:text-5xl font-bold text-gray-900">
				Producers Like You Are Already Winning
			</h2>
			<p class="text-xl text-gray-600 max-w-2xl self-center">
				Our producers in action: screenshots from advisors writing consistent $100K+ annuity opportunities with Century Digital leads.
			</p>
		</div>

		<div class="w-full grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 md:gap-6">
			<img
				src="/testimonials/century-digital-annuity-testimonial-10.png"
				alt="Century Digital testimonial screenshot highlighting multiple annuity policies written from one producer"
				class="w-full rounded-xl border border-[#93c5fd] shadow-sm"
				loading="lazy"
				width="800"
				height="800"
			/>
			<img
				src="/testimonials/century-digital-annuity-testimonial-02.png"
				alt="Century Digital testimonial screenshot highlighting qualified annuity lead and strong case size"
				class="w-full rounded-xl border border-[#93c5fd] shadow-sm"
				loading="lazy"
				width="800"
				height="800"
			/>
			<img
				src="/testimonials/century-digital-annuity-testimonial-03.png"
				alt="Producer message sharing successful fixed indexed annuity placement from Century Digital lead"
				class="w-full rounded-xl border border-[#93c5fd] shadow-sm"
				loading="lazy"
				width="800"
				height="800"
			/>
			<img
				src="/testimonials/century-digital-annuity-testimonial-04.png"
				alt="Screenshot of advisor confirming closed annuity case driven by Century Digital campaign"
				class="w-full rounded-xl border border-[#93c5fd] shadow-sm"
				loading="lazy"
				width="800"
				height="800"
			/>
			<img
				src="/testimonials/century-digital-annuity-testimonial-05.png"
				alt="Century Digital lead testimonial emphasizing high-intent retirement prospects and rollover assets"
				class="w-full rounded-xl border border-[#93c5fd] shadow-sm"
				loading="lazy"
				width="800"
				height="800"
			/>
			<img
				src="/testimonials/century-digital-annuity-testimonial-06.png"
				alt="Advisor sharing results from Century Digital annuity marketing with strong premium written"
				class="w-full rounded-xl border border-[#93c5fd] shadow-sm"
				loading="lazy"
				width="800"
				height="800"
			/>
			<img
				src="/testimonials/century-digital-annuity-testimonial-07.png"
				alt="MDRT-level producer feedback about consistent annuity production from Century Digital pipeline"
				class="w-full rounded-xl border border-[#93c5fd] shadow-sm"
				loading="lazy"
				width="800"
				height="800"
			/>
			<img
				src="/testimonials/century-digital-annuity-testimonial-08.png"
				alt="Testimonial screenshot showing multiple closed annuity cases from Century Digital program"
				class="w-full rounded-xl border border-[#93c5fd] shadow-sm"
				loading="lazy"
				width="800"
				height="800"
			/>
