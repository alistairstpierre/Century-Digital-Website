---
// Script Request Form Component
// Collects phone numbers with Twilio A2P 10DLC compliant consent
---

<section id="script-form" class="w-full bg-gray-50 scroll-mt-24 px-4 sm:px-6">
	<div class="section-inner flex flex-col gap-4">
		<div class="text-center flex flex-col items-center gap-4">
			<h2 class="text-4xl md:text-5xl font-bold text-gray-900">
				Get Your Closing Script
			</h2>
			<p class="text-xl text-gray-600 max-w-2xl self-center">
				Fill out the form below to receive a proven script that will help you close more clients.
			</p>
		</div>

		<div class="w-full max-w-2xl self-center">
			<form 
				id="script-request-form" 
				class="form-box bg-white rounded-xl border border-[#93c5fd] shadow-sm hover:shadow-md transition-shadow space-y-1 reveal"
				method="POST"
				action="#"
			>
				<!-- Name Field -->
				<div class="space-y-2">
					<label for="name" class="block text-sm font-semibold text-gray-900">
						Full Name <span class="text-red-500">*</span>
					</label>
					<input 
						type="text" 
						id="name" 
						name="name" 
						required
						class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#1e40af] focus:border-[#1e40af] outline-none transition-all"
						placeholder="John Doe"
					/>
				</div>

				<!-- Email Field -->
				<div class="space-y-2">
					<label for="email" class="block text-sm font-semibold text-gray-900">
						Email Address <span class="text-red-500">*</span>
					</label>
					<input 
						type="email" 
						id="email" 
						name="email" 
						required
						class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#1e40af] focus:border-[#1e40af] outline-none transition-all"
						placeholder="john@example.com"
					/>
				</div>

				<!-- Phone Number Field -->
				<div class="space-y-2">
					<label for="phone" class="block text-sm font-semibold text-gray-900">
						Phone Number <span class="text-red-500">*</span>
					</label>
					<input 
						type="tel" 
						id="phone" 
						name="phone" 
						required
						pattern="[0-9]{10,15}"
						class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#1e40af] focus:border-[#1e40af] outline-none transition-all"
						placeholder="(555) 123-4567"
					/>
					<p class="text-xs text-gray-500">Enter your 10-digit phone number</p>
				</div>

				<!-- Company/Title Field -->
				<div class="space-y-2">
					<label for="company" class="block text-sm font-semibold text-gray-900">
						Company / Title (Optional)
					</label>
					<input 
						type="text" 
						id="company" 
						name="company"
						class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#1e40af] focus:border-[#1e40af] outline-none transition-all"
						placeholder="Independent Producer"
					/>
				</div>

				<!-- SMS Consent - A2P 10DLC Compliant -->
				<div class="bg-[#eff6ff] border border-[#93c5fd] rounded-lg p-6 space-y-3">
					<div class="flex items-start gap-3">
						<input 
							type="checkbox" 
							id="sms-consent" 
							name="sms_consent"
							required
							class="mt-1 w-5 h-5 text-[#1e40af] border-gray-300 rounded focus:ring-[#1e40af] flex-shrink-0"
						/>
						<label for="sms-consent" class="text-sm text-gray-700">
							<strong>I consent to receive text messages from Century Digital</strong> <span class="text-red-500">*</span>
							<br />
							<span class="text-xs text-gray-600 mt-2 block">
								By checking this box, you agree to receive automated text messages from Century Digital at the phone number provided above. Message and data rates may apply. Message frequency varies. You can opt out at any time by replying STOP. For help, reply HELP. Our SMS services are provided through Twilio, Inc., registered with The Campaign Registry (TCR) for A2P 10DLC messaging.
							</span>
						</label>
					</div>
				</div>

				<!-- Marketing Consent (Optional) -->
				<div class="flex items-start gap-3 pt-2">
					<input 
						type="checkbox" 
						id="marketing-consent" 
						name="marketing_consent"
						class="mt-1 w-5 h-5 text-[#1e40af] border-gray-300 rounded focus:ring-[#1e40af] flex-shrink-0"
					/>
					<label for="marketing-consent" class="text-sm text-gray-700">
						I would like to receive marketing communications and updates about Century Digital services (optional)
					</label>
				</div>

				<!-- Terms Acceptance -->
				<div class="flex items-start gap-3 pt-2">
					<input 
						type="checkbox" 
						id="terms-consent" 
						name="terms_consent"
						required
						class="mt-1 w-5 h-5 text-[#1e40af] border-gray-300 rounded focus:ring-[#1e40af] flex-shrink-0"
					/>
					<label for="terms-consent" class="text-sm text-gray-700">
						I agree to the <a href="/terms-of-use" class="text-[#1e40af] hover:underline font-semibold">Terms of Use</a> and <a href="/privacy-policy" class="text-[#1e40af] hover:underline font-semibold">Privacy Policy</a> <span class="text-red-500">*</span>
					</label>
				</div>

				<!-- Submit Button -->
				<div class="pt-4">
					<button 
						type="submit"
						class="w-full btn-cta bg-gradient-to-r from-[#1e40af] to-[#1e293b] rounded-2xl text-xl font-semibold hover:from-[#1e3a8a] hover:to-[#0f172a] transition-all transform hover:scale-105 text-white py-4 px-6 shadow-lg"
					>
						Get My Closing Script →
					</button>
				</div>

				<!-- Compliance Notice -->
				<p class="text-xs text-gray-500 text-center pt-2">
					By submitting this form, you acknowledge that you have read and agree to our Terms of Use and Privacy Policy. Your information will be used to send you the requested script and may be used for marketing purposes if you have opted in.
				</p>
			</form>
		</div>
	</div>
</section>

<script>
	// Form submission handler
	const form = document.getElementById('script-request-form');
	const smsConsent = document.getElementById('sms-consent');
	const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement;
	
	if (form) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			
			// Validate SMS consent if phone number is provided
			const phone = document.getElementById('phone') as HTMLInputElement;
			if (phone.value && !smsConsent.checked) {
				alert('Please consent to receive text messages to receive your script via SMS.');
				return;
			}
			
			// Disable submit button to prevent double submissions
			if (submitButton) {
				submitButton.disabled = true;
				submitButton.textContent = 'Sending...';
			}
			
			try {
				// Get form data
				const formData = new FormData(form);
				const data = Object.fromEntries(formData);
				
				// Send to API endpoint
				const response = await fetch('/api/submit-form', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
					},
					body: JSON.stringify(data),
				});
				
				const result = await response.json();
				
				if (result.success) {
					// Show success message
					alert('Thank you! Your script request has been received. We will send it to your email and phone number shortly.');
					form.reset();
				} else {
					// Show error message
					alert('There was an error submitting your form. Please try again or contact us directly at support@centurydigital.net');
					console.error('Form submission error:', result.error);
				}
			} catch (error) {
				console.error('Form submission error:', error);
				alert('There was an error submitting your form. Please try again or contact us directly at support@centurydigital.net');
			} finally {
				// Re-enable submit button
				if (submitButton) {
					submitButton.disabled = false;
					submitButton.textContent = 'Get My Closing Script →';
				}
			}
		});
	}
</script>
