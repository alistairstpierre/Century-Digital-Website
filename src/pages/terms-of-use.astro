---
// Terms of Use page for Century Digital
// Compliant with Twilio A2P 10DLC and brand registration requirements
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Terms of Use - Century Digital | Service Terms & SMS Messaging Terms';
const pageDescription = 'Century Digital Terms of Use. Read our terms and conditions for annuity lead generation services. Includes SMS/text messaging terms, A2P 10DLC compliance, user responsibilities, and service agreements.';
const pageKeywords = 'terms of use, terms and conditions, service agreement, SMS terms, A2P compliance, Twilio terms, user agreement, Century Digital terms';
const pageUrl = Astro.url.href;
---

<Layout 
	title={pageTitle}
	description={pageDescription}
	canonicalURL={pageUrl}
	pageName="Terms of Use"
	keywords={pageKeywords}
>
	<Navigation />
	<main class="w-full bg-white px-4 sm:px-6" style="padding-top: 6rem;">
		<div class="section-inner flex flex-col gap-4" style="padding-top: 0;">
			<div class="text-center flex flex-col items-center gap-4 mb-8">
				<h1 class="text-4xl md:text-5xl font-bold text-gray-900">Terms of Use</h1>
				<p class="text-xl text-gray-600">Last Updated: January 27, 2026</p>
			</div>

			<article class="w-full max-w-4xl mx-auto" itemscope itemtype="https://schema.org/Article">
				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">1. Agreement to Terms</h2>
					<p class="text-gray-700 mb-4">
						By accessing or using the Century Digital website ("Website") and services ("Services"), you agree to be bound by these Terms of Use ("Terms"). If you do not agree to these Terms, please do not use our Website or Services.
					</p>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">2. Description of Services</h2>
					<p class="text-gray-700 mb-4">
						Century Digital provides premium annuity lead generation services for Independent Producers and Financial Advisors. Our services include:
					</p>
					<ul class="list-disc pl-6 text-gray-700 mb-4 space-y-2">
						<li>High-intent annuity leads</li>
						<li>Internal Sales Agent (ISA) team services</li>
						<li>Sales coaching and training</li>
						<li>Social media advertising</li>
						<li>Appointment scheduling and confirmation via SMS</li>
					</ul>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">3. SMS/Text Messaging Terms - A2P 10DLC Compliance</h2>
					<h3 class="text-xl font-semibold text-gray-900 mb-3">3.1 Consent and Registration</h3>
					<p class="text-gray-700 mb-4">
						By providing your phone number and opting in to receive text messages, you consent to receive automated text messages from Century Digital. Our SMS services are provided through Twilio, Inc., which is registered with The Campaign Registry (TCR) for A2P 10DLC messaging. Our brand is registered and compliant with all applicable regulations.
					</p>
					<h3 class="text-xl font-semibold text-gray-900 mb-3">3.2 Message Types</h3>
					<p class="text-gray-700 mb-4">You may receive the following types of messages:</p>
					<ul class="list-disc pl-6 text-gray-700 mb-4 space-y-2">
						<li>Appointment confirmations and reminders</li>
						<li>Service updates and notifications</li>
						<li>Marketing communications (only if you have opted in)</li>
						<li>Account-related messages</li>
					</ul>
					<h3 class="text-xl font-semibold text-gray-900 mb-3">3.3 Message Frequency and Charges</h3>
					<p class="text-gray-700 mb-4">
						Message frequency varies. Standard message and data rates may apply. Charges are determined by your mobile carrier. Century Digital is not responsible for any charges incurred.
					</p>
					<h3 class="text-xl font-semibold text-gray-900 mb-3">3.4 Opt-Out</h3>
					<p class="text-gray-700 mb-4">
						You may opt out of receiving text messages at any time by:
					</p>
					<ul class="list-disc pl-6 text-gray-700 mb-4 space-y-2">
						<li>Replying STOP to any text message</li>
						<li>Replying UNSUBSCRIBE to any text message</li>
						<li>Contacting us at support@centurydigital.net</li>
					</ul>
					<p class="text-gray-700 mb-4">
						After opting out, you may receive one final confirmation message. For help, reply HELP.
					</p>
					<h3 class="text-xl font-semibold text-gray-900 mb-3">3.5 Carrier Limitations</h3>
					<p class="text-gray-700 mb-4">
						Not all carriers support SMS messaging. Century Digital is not responsible for message delivery failures due to carrier limitations or network issues.
					</p>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">4. User Responsibilities</h2>
					<p class="text-gray-700 mb-4">You agree to:</p>
					<ul class="list-disc pl-6 text-gray-700 mb-4 space-y-2">
						<li>Provide accurate and complete information</li>
						<li>Maintain the security of your account credentials</li>
						<li>Use our Services only for lawful purposes</li>
						<li>Comply with all applicable laws and regulations</li>
						<li>Not use our Services to send spam or unsolicited messages</li>
					</ul>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">5. Intellectual Property</h2>
					<p class="text-gray-700 mb-4">
						All content on this Website, including text, graphics, logos, and software, is the property of Century Digital or its licensors and is protected by copyright and other intellectual property laws.
					</p>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">6. Disclaimer of Warranties</h2>
					<p class="text-gray-700 mb-4">
						Our Services are provided "as is" and "as available" without warranties of any kind, either express or implied. We do not guarantee that our Services will be uninterrupted, error-free, or secure.
					</p>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">7. Limitation of Liability</h2>
					<p class="text-gray-700 mb-4">
						To the maximum extent permitted by law, Century Digital shall not be liable for any indirect, incidental, special, consequential, or punitive damages arising out of or relating to your use of our Services.
					</p>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">8. Indemnification</h2>
					<p class="text-gray-700 mb-4">
						You agree to indemnify and hold harmless Century Digital from any claims, damages, losses, or expenses arising out of your use of our Services or violation of these Terms.
					</p>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">9. Termination</h2>
					<p class="text-gray-700 mb-4">
						We reserve the right to terminate or suspend your access to our Services at any time, with or without cause or notice, for any reason, including violation of these Terms.
					</p>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">10. Changes to Terms</h2>
					<p class="text-gray-700 mb-4">
						We may modify these Terms at any time. We will notify you of any material changes by posting the updated Terms on this page and updating the "Last Updated" date. Your continued use of our Services after such changes constitutes acceptance of the modified Terms.
					</p>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">11. Governing Law</h2>
					<p class="text-gray-700 mb-4">
						These Terms shall be governed by and construed in accordance with the laws of [Your State/Country], without regard to its conflict of law provisions.
					</p>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">12. Contact Information</h2>
					<p class="text-gray-700 mb-4">
						If you have questions about these Terms, please contact us:
					</p>
					<div class="bg-gray-50 p-6 rounded-xl border border-[#93c5fd]">
						<p class="text-gray-700 mb-2"><strong>Century Digital</strong></p>
						<p class="text-gray-700 mb-2">Email: <a href="mailto:support@centurydigital.net" class="text-[#1e40af] hover:underline">support@centurydigital.net</a></p>
						<p class="text-gray-700">Website: <a href="https://centurydigital.net" class="text-[#1e40af] hover:underline">centurydigital.net</a></p>
					</div>
				</section>
			</article>
		</div>
	</main>
	<Footer />
</Layout>
