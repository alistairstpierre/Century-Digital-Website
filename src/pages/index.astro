---
// Main landing page for Century Digital
// Combines all components to create the complete website experience
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Testimonials from '../components/Testimonials.astro';
import Features from '../components/Features.astro';
import About from '../components/About.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

const seoTitle = 'Century Digital - Premium Annuity Lead Generation for Insurance Agents';
const seoDescription = 'Get high-intent annuity leads that actually answer the phone. 48% close rate, 41% lead-to-appointment rate. Stop chasing disconnected numbers. Start writing paper with qualified contract owners ready to protect their principal.';
---

<Layout 
	title={seoTitle}
	description={seoDescription}
	canonicalURL={Astro.url.href}
>
	<Navigation />
	<main>
		<Hero />
		<Testimonials />
		<Features />
		<About />
		<FAQ />
	</main>
	<Footer />
	<ScrollReveal />
</Layout>
