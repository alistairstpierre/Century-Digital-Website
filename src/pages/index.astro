---
// Main landing page for Century Digital
// Combines all components to create the complete website experience
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Testimonials from '../components/Testimonials.astro';
import Features from '../components/Features.astro';
import About from '../components/About.astro';
import FAQ from '../components/FAQ.astro';
import ScriptForm from '../components/ScriptForm.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

const seoTitle = 'Get Qualified Annuity Prospects With $100K+ Ready to Roll Over | Century Digital';
const seoDescription = 'Get in touch with age 55–77 annuity prospects who have $100K+ rollover‑eligible assets. AI finder, OTP verification, opt-in only. Exclusive daily prospects, state-matched. Consistent $100K+ annuity opportunities for top producers.';
const seoKeywords = 'annuity prospects, annuity leads, $100K+ annuity opportunities, AI annuity opportunity finder, qualified annuity leads, age 55-77 retirement, rollover eligible assets, exclusive annuity prospects, state-matched leads, independent producers, financial advisors';
---

<Layout 
	title={seoTitle}
	description={seoDescription}
	canonicalURL={Astro.url.href}
	pageName="Home"
	keywords={seoKeywords}
>
	<Navigation />
	<main>
		<Hero />
		<Testimonials />
		<Features />
		<About />
		<FAQ />
		<ScriptForm />
	</main>
	<Footer />
	<ScrollReveal />
</Layout>
