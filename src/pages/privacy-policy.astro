---
// Privacy Policy page for Century Digital
// Compliant with Twilio A2P 10DLC and brand registration requirements
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Privacy Policy - Century Digital | Data Protection & SMS Compliance';
const pageDescription = 'Century Digital Privacy Policy. Learn how we collect, use, and protect your information. Compliant with TCPA and Twilio A2P 10DLC requirements. Includes SMS/text messaging consent, opt-out instructions, and data security practices.';
const pageKeywords = 'privacy policy, data protection, SMS compliance, TCPA, A2P 10DLC, Twilio compliance, text messaging consent, data privacy, information security, Century Digital privacy';
const pageUrl = Astro.url.href;
---

<Layout 
	title={pageTitle}
	description={pageDescription}
	canonicalURL={pageUrl}
	pageName="Privacy Policy"
	keywords={pageKeywords}
>
	<Navigation />
	<main class="w-full bg-white px-4 sm:px-6" style="padding-top: 6rem;">
		<div class="section-inner flex flex-col gap-4" style="padding-top: 0;">
			<div class="text-center flex flex-col items-center gap-4 mb-8">
				<h1 class="text-4xl md:text-5xl font-bold text-gray-900">Privacy Policy</h1>
				<p class="text-xl text-gray-600">Last Updated: January 27, 2026</p>
			</div>

			<article class="w-full max-w-4xl mx-auto" itemscope itemtype="https://schema.org/Article">
				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">1. Introduction</h2>
					<p class="text-gray-700 mb-4">
						Century Digital ("we," "our," or "us") is committed to protecting your privacy. This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you visit our website, use our services, or interact with us via SMS/text messaging.
					</p>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">2. Information We Collect</h2>
					<h3 class="text-xl font-semibold text-gray-900 mb-3">2.1 Information You Provide</h3>
					<ul class="list-disc pl-6 text-gray-700 mb-4 space-y-2">
						<li>Name and contact information (email address, phone number)</li>
						<li>Business information (company name, title, industry)</li>
						<li>Information submitted through forms on our website</li>
						<li>Communications with us via email, phone, or SMS</li>
					</ul>
					<h3 class="text-xl font-semibold text-gray-900 mb-3">2.2 Automatically Collected Information</h3>
					<ul class="list-disc pl-6 text-gray-700 mb-4 space-y-2">
						<li>IP address and browser type</li>
						<li>Pages visited and time spent on our website</li>
						<li>Device information and operating system</li>
					</ul>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">3. SMS/Text Messaging - A2P 10DLC Compliance</h2>
					<p class="text-gray-700 mb-4">
						<strong>Important:</strong> By providing your phone number and opting in to receive text messages, you consent to receive automated text messages from Century Digital. Message and data rates may apply.
					</p>
					<h3 class="text-xl font-semibold text-gray-900 mb-3">3.1 Consent and Opt-In</h3>
					<p class="text-gray-700 mb-4">
						We comply with the Telephone Consumer Protection Act (TCPA) and Twilio's A2P 10DLC requirements. You will only receive text messages if you have explicitly opted in by:
					</p>
					<ul class="list-disc pl-6 text-gray-700 mb-4 space-y-2">
						<li>Checking the consent box on our form</li>
						<li>Providing your phone number with clear consent language</li>
						<li>Confirming your opt-in via double opt-in when required</li>
					</ul>
					<h3 class="text-xl font-semibold text-gray-900 mb-3">3.2 Message Frequency</h3>
					<p class="text-gray-700 mb-4">
						Message frequency varies. You may receive messages related to your inquiry, appointment reminders, service updates, and marketing communications (if you have opted in).
					</p>
					<h3 class="text-xl font-semibold text-gray-900 mb-3">3.3 Opt-Out Instructions</h3>
					<p class="text-gray-700 mb-4">
						You can opt out of receiving text messages at any time by:
					</p>
					<ul class="list-disc pl-6 text-gray-700 mb-4 space-y-2">
						<li>Replying STOP to any text message</li>
						<li>Replying UNSUBSCRIBE to any text message</li>
						<li>Contacting us at support@centurydigital.net</li>
						<li>Calling us at [Your Phone Number]</li>
					</ul>
					<p class="text-gray-700 mb-4">
						After opting out, you may receive one final confirmation message. Message and data rates may apply. For help, reply HELP.
					</p>
					<h3 class="text-xl font-semibold text-gray-900 mb-3">3.4 Carrier Information</h3>
					<p class="text-gray-700 mb-4">
						We use Twilio, Inc. as our SMS service provider. Twilio is registered with The Campaign Registry (TCR) for A2P 10DLC messaging. Our brand is registered and compliant with all applicable regulations.
					</p>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">4. How We Use Your Information</h2>
					<p class="text-gray-700 mb-4">We use the information we collect to:</p>
					<ul class="list-disc pl-6 text-gray-700 mb-4 space-y-2">
						<li>Provide, maintain, and improve our services</li>
						<li>Respond to your inquiries and provide customer support</li>
						<li>Send you information about our services (with your consent)</li>
						<li>Send appointment reminders and service updates via SMS</li>
						<li>Comply with legal obligations</li>
						<li>Prevent fraud and ensure security</li>
					</ul>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">5. Information Sharing and Disclosure</h2>
					<p class="text-gray-700 mb-4">
						We do not sell your personal information. We may share your information with:
					</p>
					<ul class="list-disc pl-6 text-gray-700 mb-4 space-y-2">
						<li><strong>Service Providers:</strong> Twilio (for SMS services), hosting providers, analytics services</li>
						<li><strong>Legal Requirements:</strong> When required by law or to protect our rights</li>
						<li><strong>Business Transfers:</strong> In connection with a merger, acquisition, or sale of assets</li>
					</ul>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">6. Data Security</h2>
					<p class="text-gray-700 mb-4">
						We implement appropriate technical and organizational measures to protect your personal information. However, no method of transmission over the Internet is 100% secure.
					</p>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">7. Your Rights</h2>
					<p class="text-gray-700 mb-4">You have the right to:</p>
					<ul class="list-disc pl-6 text-gray-700 mb-4 space-y-2">
						<li>Access and receive a copy of your personal information</li>
						<li>Correct inaccurate information</li>
						<li>Request deletion of your information</li>
						<li>Opt out of marketing communications</li>
						<li>Opt out of SMS/text messages (reply STOP)</li>
					</ul>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">8. Children's Privacy</h2>
					<p class="text-gray-700 mb-4">
						Our services are not intended for individuals under 18 years of age. We do not knowingly collect personal information from children.
					</p>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">9. Changes to This Privacy Policy</h2>
					<p class="text-gray-700 mb-4">
						We may update this Privacy Policy from time to time. We will notify you of any changes by posting the new Privacy Policy on this page and updating the "Last Updated" date.
					</p>
				</section>

				<section class="mb-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-4">10. Contact Us</h2>
					<p class="text-gray-700 mb-4">
						If you have questions about this Privacy Policy or our data practices, please contact us:
					</p>
					<div class="bg-gray-50 p-6 rounded-xl border border-[#93c5fd]">
						<p class="text-gray-700 mb-2"><strong>Century Digital</strong></p>
						<p class="text-gray-700 mb-2">Email: <a href="mailto:support@centurydigital.net" class="text-[#1e40af] hover:underline">support@centurydigital.net</a></p>
						<p class="text-gray-700">Website: <a href="https://centurydigital.net" class="text-[#1e40af] hover:underline">centurydigital.net</a></p>
					</div>
				</section>
			</article>
		</div>
	</main>
	<Footer />
</Layout>
