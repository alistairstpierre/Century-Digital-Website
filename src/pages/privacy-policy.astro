---
// Privacy Policy page for Century Digital
// Compliant with Twilio A2P 10DLC and brand registration requirements
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const effectiveDate = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const pageTitle = 'Privacy Policy - Century Digital | Data Protection & SMS Compliance';
const pageDescription = 'Century Digital Privacy Policy. Learn how we collect, use, and protect your information. Compliant with TCPA and Twilio A2P 10DLC requirements. Includes SMS/text messaging consent, opt-out instructions, and data security practices.';
const pageKeywords = 'privacy policy, data protection, SMS compliance, TCPA, A2P 10DLC, Twilio compliance, text messaging consent, data privacy, information security, Century Digital privacy';
const pageUrl = Astro.url.href;
---

<Layout 
	title={pageTitle}
	description={pageDescription}
	canonicalURL={pageUrl}
	pageName="Privacy Policy"
	keywords={pageKeywords}
>
	<Navigation />
	<main class="w-full bg-white px-4 sm:px-6" style="padding-top: 6rem;">
		<div class="section-inner flex flex-col gap-4" style="padding-top: 0;">
			<div class="text-center flex flex-col items-center gap-4 mb-8">
				<h1 class="text-4xl md:text-5xl font-bold text-gray-900">Privacy Policy</h1>
				<p class="text-xl text-gray-600">Effective Date: {effectiveDate}</p>
			</div>

			<article class="w-full max-w-4xl mx-auto legal-prose" itemscope itemtype="https://schema.org/Article">
				<section class="mb-12 space-y-6">
					<p class="text-gray-700">
						Century Digital ("Century Digital", "we", "us", or "our") is committed to protecting your privacy. This Privacy Policy explains how we collect, use, store, and protect your information when you visit our website or communicate with us.
					</p>
				</section>

				<section class="mb-12 space-y-6">
					<h2 class="text-2xl font-bold text-gray-900">Information We Collect</h2>
					<p class="text-gray-700">We may collect the following types of information:</p>
					<ul class="list-disc pl-6 text-gray-700 space-y-2">
						<li>Personal information you voluntarily provide, including name, email address, phone number, and business details</li>
						<li>Information submitted through contact forms, lead forms, or consultation requests</li>
						<li>Technical information such as IP address, browser type, device information, and usage data</li>
						<li>Communication records, including emails and text messages exchanged with us</li>
					</ul>
				</section>

				<section class="mb-12 space-y-6">
					<h2 class="text-2xl font-bold text-gray-900">How We Use Your Information</h2>
					<p class="text-gray-700">We use the information we collect to:</p>
					<ul class="list-disc pl-6 text-gray-700 space-y-2">
						<li>Respond to inquiries and consultation requests</li>
						<li>Schedule, confirm, and manage appointments</li>
						<li>Provide requested services and communications</li>
						<li>Improve our website, services, and customer experience</li>
						<li>Comply with legal, regulatory, and contractual obligations</li>
					</ul>
					<p class="text-gray-700">
						We do <strong>not</strong> use your information for purposes you did not consent to.
					</p>
				</section>

				<section class="mb-12 space-y-6">
					<h2 class="text-2xl font-bold text-gray-900">SMS Communications</h2>
					<p class="text-gray-700">
						If you provide your mobile phone number, Century Digital may send you <strong>appointment-related text messages</strong> that you have requested. These messages may include appointment confirmations, reminders, rescheduling notifications, access or join-link updates (phone or Zoom), and brief post-appointment follow-ups.
					</p>
					<p class="text-gray-700">
						SMS consent is obtained when you submit a form that includes a clear disclosure stating that you agree to receive appointment-related text messages from Century Digital. Message frequency varies. Message and data rates may apply.
					</p>
					<p class="text-gray-700">
						You may opt out of SMS communications at any time by replying <strong>STOP</strong>. For assistance, reply <strong>HELP</strong> or contact <a href="mailto:support@centurydigital.net" class="text-[#1e40af] hover:underline">support@centurydigital.net</a>.
					</p>
					<p class="text-gray-700">
						Century Digital does <strong>not</strong> send marketing or promotional SMS messages.
					</p>
				</section>

				<section class="mb-12 space-y-6">
					<h2 class="text-2xl font-bold text-gray-900">Mobile Information Sharing</h2>
					<p class="text-gray-700">
						Century Digital does <strong>not</strong> sell, rent, share, or disclose mobile phone numbers or SMS consent information to third parties or affiliates for marketing or promotional purposes.
					</p>
					<p class="text-gray-700">
						Mobile information is used <strong>solely</strong> to deliver the communications you have requested.
					</p>
				</section>

				<section class="mb-12 space-y-6">
					<h2 class="text-2xl font-bold text-gray-900">Cookies and Tracking Technologies</h2>
					<p class="text-gray-700">
						We may use cookies and similar technologies to improve website functionality, analyze usage, and enhance user experience. You can control cookie settings through your browser preferences.
					</p>
				</section>

				<section class="mb-12 space-y-6">
					<h2 class="text-2xl font-bold text-gray-900">Data Security</h2>
					<p class="text-gray-700">
						We take reasonable administrative, technical, and physical measures to protect your information from unauthorized access, misuse, or disclosure. No method of transmission or storage is 100% secure, and we cannot guarantee absolute security.
					</p>
				</section>

				<section class="mb-12 space-y-6">
					<h2 class="text-2xl font-bold text-gray-900">Data Retention</h2>
					<p class="text-gray-700">
						We retain personal information only for as long as necessary to fulfill the purposes described in this Privacy Policy, comply with legal obligations, resolve disputes, and enforce agreements.
					</p>
				</section>

				<section class="mb-12 space-y-6">
					<h2 class="text-2xl font-bold text-gray-900">Your Rights and Choices</h2>
					<p class="text-gray-700">
						You may request access to, correction of, or deletion of your personal information, subject to applicable laws. You may also withdraw consent for communications at any time.
					</p>
					<p class="text-gray-700">
						To exercise your rights, contact <a href="mailto:support@centurydigital.net" class="text-[#1e40af] hover:underline">support@centurydigital.net</a>.
					</p>
				</section>

				<section class="mb-12 space-y-6">
					<h2 class="text-2xl font-bold text-gray-900">Third-Party Services</h2>
					<p class="text-gray-700">
						Our website or communications may include links to third-party services. We are not responsible for the privacy practices of those third parties.
					</p>
				</section>

				<section class="mb-12 space-y-6">
					<h2 class="text-2xl font-bold text-gray-900">Changes to This Policy</h2>
					<p class="text-gray-700">
						We may update this Privacy Policy from time to time. Any changes will be posted on this page with an updated effective date.
					</p>
				</section>

				<section class="mb-12 space-y-6">
					<h2 class="text-2xl font-bold text-gray-900">Contact Information</h2>
					<div class="bg-gray-50 p-6 rounded-xl border border-[#93c5fd]">
						<p class="text-gray-700 mb-2"><strong>Century Digital</strong></p>
						<p class="text-gray-700 mb-2">Email: <a href="mailto:support@centurydigital.net" class="text-[#1e40af] hover:underline">support@centurydigital.net</a></p>
						<p class="text-gray-700">Website: <a href="https://www.centurydigital.net" class="text-[#1e40af] hover:underline">www.centurydigital.net</a></p>
					</div>
				</section>
			</article>
		</div>
	</main>
	<Footer />
</Layout>
